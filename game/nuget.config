<?xml version="1.0" encoding="utf-8"?>
<!--
  This machine has a stale Xamarin fallback package folder registered globally
  (C:\Microsoft\Xamarin\NuGet\), left behind by an old install. NuGet treats a
  missing fallback folder as a hard error, so every restore fails before it even
  reaches nuget.org:

    error MSB4242: Unable to find fallback package folder 'C:\Microsoft\Xamarin\NuGet\'

  Clearing the list here fixes it for this project without touching machine-wide
  configuration. Harmless on a machine that does not have the problem.
-->
<configuration>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>

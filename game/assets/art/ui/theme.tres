; Project-wide theme, set in project.godot under gui/theme/custom.
;
; Sizes here are deliberately large: everything has to stay readable and
; tappable on a phone, and a UI that works on a phone always works on a monitor.

[gd_resource type="Theme" load_steps=6 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_normal"]
